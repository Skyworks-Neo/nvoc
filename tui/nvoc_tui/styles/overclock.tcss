#overclock-groups {
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
}

.narrow #overclock-groups {
    grid-size: 1 4;
    grid-columns: 1fr;
}

#clock-controls,
#pstate-controls,
#power-controls,
#mobile-controls,
#fan-controls {
    grid-gutter: 0 1;
    height: auto;
    align-horizontal: center;
    grid-columns: 1fr;
}

#clock-controls {
    grid-size: 1 3;
}

#pstate-controls {
    grid-size: 1 2;
}

#power-controls,
#fan-controls {
    grid-size: 1 4;
}

#mobile-controls {
    grid-size: 1 5;
}

.wide #clock-controls {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
}

.wide #pstate-controls {
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
}

.wide #power-controls,
.wide #fan-controls {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
}

.wide #mobile-controls {
    grid-size: 2 3;
    grid-columns: 1fr 1fr;
}

#clock-actions,
#pstate-actions,
#power-actions,
#mobile-actions,
#fan-actions {
    grid-gutter: 0 1;
    height: auto;
    align-horizontal: center;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
}

#overclock .row {
    align-horizontal: left;
}

#overclock .row > Label {
    width: 14;
}

#overclock Select {
    width: 12;
}

#overclock .nvapi-nvml-select {
    width: 8;
}

/* Fanless server cards (P100/A100 …): the whole Fan pane greys out.
   #fan-controls is set .disabled by the controller; the :disabled
   pseudo-class cascades to every child (built-in widget dim styles) and
   the pane-level opacity tints the rows with no interactive widget. */
#fan-controls:disabled,
#fan-actions:disabled {
    opacity: 0.45;
    text-opacity: 0.55;
}
