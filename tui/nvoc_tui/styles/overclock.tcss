#overclock-groups {
    grid-size: 4 1;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
}

.narrow #overclock-groups {
    grid-size: 1 4;
    grid-columns: 1fr;
}

#clock-controls,
#pstate-controls,
#power-controls,
#mobile-controls,
#fan-controls {
    grid-gutter: 0 1;
    height: auto;
    align-horizontal: center;
    grid-columns: 1fr;
}

/* One cell per row — Core/Mem/Xbar/Sys/Msd/Host. The template historically
   said 3, so Textual's grid gave Sys/Msd/Host zero-size (never rendered). */
#clock-controls {
    grid-size: 1 6;
}

#pstate-controls {
    grid-size: 1 2;
}

#power-controls,
#fan-controls {
    grid-size: 1 4;
}

#mobile-controls {
    grid-size: 1 5;
}

#clock-actions,
#pstate-actions,
#power-actions,
#mobile-actions,
#fan-actions {
    grid-gutter: 0 1;
    height: auto;
    align-horizontal: center;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
}

#overclock .row {
    align-horizontal: left;
}

#overclock .row > Label {
    width: 14;
}

#overclock Select {
    width: 12;
}

#overclock .nvapi-nvml-select {
    width: 8;
}

/* Fanless server cards (P100/A100 …): the whole Fan pane greys out.
   #fan-controls is set .disabled by the controller; the :disabled
   pseudo-class cascades to every child (built-in widget dim styles) and
   the pane-level opacity tints the rows with no interactive widget. */
#fan-controls:disabled,
#fan-actions:disabled {
    opacity: 0.45;
    text-opacity: 0.55;
}

/* MHz/mV unit toggle (GUI V/F Offsets parity): a 3-col chip appended after
   each offset input — the row keeps the original label/input geometry and
   grows by exactly the chip's columns ("MHz" / "mV"). width:auto is
   unusable (Button.get_content_width hardcodes a +2 fudge) and Button's
   min-width: 16 default is cleared here. line_pad is zeroed in the
   UnitToggle widget (TCSS integers must be > 0); `.volt` marks the mV
   plane with the accent color. */
#clock-controls .row > Input,
#power-controls .row > Input {
    margin-right: 0; /* the unit takes the freed column — row = original + N */
}

#clock-controls .unit-toggle {
    width: 3;
    min-width: 0;
    margin: 0;
}

/* Power pane unit labels (display only): Power Limit %/W follows the
   #power-api selector, Thermal C, Voltage Boost %/mV (legacy Overvolt).
   specificity must beat the pane-wide `#overclock .row > Label` width. */
#overclock .row > Label.unit-label {
    width: 3;
    margin: 0;
    text-opacity: 0.7;
}

#clock-controls .unit-toggle.volt {
    background: $accent;
    text-opacity: 1;
}
