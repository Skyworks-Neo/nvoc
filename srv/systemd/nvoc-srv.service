# NVOC closed-loop GPU thermal control (fan PID).
# Install:
#   sudo cp nvoc_service /usr/local/bin/
#   sudo cp srv/systemd/nvoc-srv.service /etc/systemd/system/
#   sudo mkdir -p /etc/nvoc && sudo $EDITOR /etc/nvoc/nvoc-srv.toml   # optional
#   sudo systemctl daemon-reload && sudo systemctl enable --now nvoc-srv
# Runs as root: NVAPI/NVML resource-manager access requires /dev/nvidia*.
# Stop is graceful: the control loop restores driver fan control on SIGTERM.

[Unit]
Description=NVOC closed-loop GPU thermal control (fan PID)
Documentation=https://github.com/nvoc/nvoc/tree/main/srv
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nvoc_service --foreground --config /etc/nvoc/nvoc-srv.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
